# copy this file to .env and fill in the key.
#
# only needed for the `openrouter` backend. the `claude-code` and `mock`
# backends do not read it.
#
# get a key at https://openrouter.ai/keys
# every model in the default chain ends in `:free`, so a normal run costs
# nothing. see OPENROUTER_CHAIN in config.py for the exact list. passing
# --model names one model instead of the chain, and a paid one will bill you.
#
# the key is read by a ~10 line parser in config.py. it is never logged, never
# returned by a server route, and never written into a run manifest.
OPENROUTER_API_KEY=
