# "it's not excitement, it's avoidance wearing a good jacket"
work: "the work itself\n(the draft at 11pm.\nthe version that doesn't work.)" {
  shape: circle
  style.fill: "#ffe8a3"
}

tool: "a new tool" {style.stroke-dash: 3}
platform: "a new platform" {style.stroke-dash: 3}
strategy: "a new strategy" {style.stroke-dash: 3}
niche: "a new niche" {style.stroke-dash: 3}
format: "a new format" {style.stroke-dash: 3}

tool -> work: "shinier the\nfurther you are"
platform -> work
strategy -> work
niche -> work
format -> work

caption: "all of it promising the outcome\nwithout asking for the process." {shape: text; style.italic: true}
caption.near: bottom-center
