  style.stroke-dash: 5
  style.fill: transparent

  skills: "skills\n(anyone can learn these)" {
    style.fill: "#f4f4f4"

    ways: "your ways" {
      style.fill: "#ffe8a3"
      style.bold: true

      t: "the tools you\ninstinctively reach for"
      p: "the pace at\nwhich you think"
      e: "how you enter\na problem"
