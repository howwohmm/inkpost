# the craft test
direction: down

thing: "anything you make" {shape: page}
q: "if someone else did it\nexactly the same way,\nwould it still feel like you?" {shape: diamond}
task: "it's a task."
craft: "it's starting to\nbecome craft." {style.fill: "#ffe8a3"}
ways: "craft is when your way\nbecomes part of the thing itself" {shape: text; style.italic: true}

thing -> q
q -> task: "yes"
q -> craft: "no"
craft -> ways
