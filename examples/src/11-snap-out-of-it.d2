# "snap out of it." — body vs mind
direction: right

body: "the body" {
  wall: "hits a wall"
  rest: "rest. obviously."
  wall -> rest: "we accept this"
}

mind: "the mind" {
  wall: "hits a wall"
  push: "“if i'm not productive\nevery minute i'm falling behind”"
  crash: "the crash.\nhumbling."
  wall -> push: "no grace given"
  push -> crash
}

athlete: "athletes don't train at max intensity every day.\nthey recover so they can perform when it matters.\nwhy should the mind be different?" {shape: text; style.italic: true}

grind: "grind" {shape: circle}
recover: "rest" {shape: circle; style.fill: "#ffe8a3"}
grind -> recover: "let it rebuild"
recover -> grind: "perform when it matters"
