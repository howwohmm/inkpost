grid-columns: 6
grid-gap: 30
r: "rectangle\n(default)"
sq: "square" {shape: square}
pg: "page\n(a post)" {shape: page}
doc: "document\n(the draft)" {shape: document}
para: "parallelogram" {shape: parallelogram}
cyl: "cylinder\n(the archive)" {shape: cylinder}
q: "queue\n(the backlog)" {shape: queue}
pkg: "package" {shape: package}
step: "step" {shape: step}
call: "callout\n(a thought)" {shape: callout}
sd: "stored_data" {shape: stored_data}
per: "person\n(me)" {shape: person}
dia: "diamond\n(a choice)" {shape: diamond}
ov: "oval" {shape: oval}
ci: "circle" {shape: circle}
hex: "hexagon\n(a deadline)" {shape: hexagon}
cl: "cloud\n(“my” thoughts)" {shape: cloud}
tx: "text\n(no border)" {shape: text}
