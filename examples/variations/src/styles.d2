grid-columns: 5
grid-gap: 40
a: "3d" {style.3d: true}
b: "multiple\n(too many versions)" {style.multiple: true}
c: "double-border" {style.double-border: true}
d: "shadow" {style.shadow: true}
e: "dots" {style.fill-pattern: dots}
f: "lines" {style.fill-pattern: lines}
g: "grain" {style.fill-pattern: grain}
h: "dashed\n(optional)" {style.stroke-dash: 5}
i: "rounded" {style.border-radius: 12}
j: "thick stroke\n(urgent)" {style.stroke-width: 5}
k: "faded\n(50% opacity)" {style.opacity: 0.5}
l: "MONO FONT" {style.font: mono}
m: "uppercase" {style.text-transform: uppercase}
n: "big" {style.font-size: 36}
o: "bold italic underline" {style.bold: true; style.italic: true; style.underline: true}
