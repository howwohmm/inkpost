shape: sequence_diagram
me: "me"
committee: "the internal committee"
clock: "the clock"

me -> committee: "should i start?"
committee -> me: "are you even ready?"
committee -> me: "which version though?"
committee -> me: "should you even be here?"
me -> me: "reorganise notion instead"
clock -> me: "12 hours left." {style.bold: true}
me -> committee: "…" 
committee -> me: "(silence)"
me -> clock: "one sitting. something decent."
