grid-rows: 2
grid-columns: 3
grid-gap: 24
p1: "6:20am.\n4 hours of sleep.\nhate the ceiling\nfor ten minutes." {shape: rectangle; width: 320; height: 240}
p2: "tea. not coffee.\nout of milk.\nspill it.\nwipe with sleeve." {width: 320; height: 240}
p3: "open the doc.\nstare at nothing." {width: 320; height: 240}
p4: "fifteen minutes\nrearranging tabs\ni won't read." {width: 320; height: 240; style.fill-pattern: dots}
p5: "type.\nbackspace.\nswear." {width: 320; height: 240}
p6: "the post.\nlumpy on purpose." {width: 320; height: 240; style.fill: "#ffe8a3"; style.bold: true}
